.title {
  margin-top: 16rpx;
  font-size: 50rpx;
  font-weight: 700;
}

.cat-row {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: 1fr 180rpx 1fr;
  gap: 10rpx;
  align-items: center;
}

.cat {
  text-align: center;
  padding: 18rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto;
  border-radius: 50%;
}

.coral {
  background: linear-gradient(135deg, #ff7a50, #ff6b6b);
}

.gold {
  background: #f5c84c;
}

.name {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.percent-wrap {
  text-align: center;
}

.percent {
  color: #ff6f5f;
  font-size: 54rpx;
  font-weight: 700;
}

.result {
  margin-top: 16rpx;
}

.result-title {
  color: #ffd166;
}

.result-main {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 700;
}

.result-desc {
  margin-top: 10rpx;
  color: #d8dce5;
  font-size: 24rpx;
  line-height: 1.4;
}

.indexes {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
}

.idx {
  height: 72rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #151515;
}

.coral-bg {
  background: #ff7a50;
}

.gold-bg {
  background: #ffd166;
}

.invite {
  margin-top: 16rpx;
  color: #6b7280;
  text-align: center;
}

.actions {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}
