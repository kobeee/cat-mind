.center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.paw-bg {
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
  background: #1c202d;
  display: flex;
  align-items: center;
  justify-content: center;
}

.paw {
  font-size: 56rpx;
}

.gen-title {
  margin-top: 30rpx;
  font-size: 46rpx;
  font-weight: 700;
}

.gen-sub {
  margin-top: 12rpx;
  color: #a6adbc;
  font-size: 24rpx;
}

.bar {
  margin-top: 52rpx;
  width: 70%;
  height: 8rpx;
  background: #383d4d;
  border-radius: 8rpx;
  overflow: hidden;
}

.fill {
  height: 100%;
  background: linear-gradient(90deg, #ff7a50, #ff6b6b);
}

.tip-label {
  margin-top: 42rpx;
  color: #ffd166;
  font-size: 20rpx;
}

.tip-content {
  margin-top: 10rpx;
  color: #c8ced8;
  font-size: 24rpx;
  line-height: 1.5;
  width: 78%;
}
