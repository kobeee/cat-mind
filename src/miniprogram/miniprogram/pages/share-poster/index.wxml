<view class="screen dark">
  <view class="nav">
    <view class="icon-btn" bindtap="onBack">←</view>
    <view class="nav-title">分享海报</view>
    <view class="icon-btn hide"></view>
  </view>

  <view class="poster dark-card">
    <view class="brand">🐱 喵星说明书</view>
    <view class="avatar">🐾</view>
    <view class="name">{{poster.title}}</view>
    <view class="sub muted">{{poster.subtitle}}</view>

    <view class="stats">
      <view class="stat" wx:for="{{poster.stats}}" wx:key="label">
        <view class="value">{{item.value}}</view>
        <view class="muted">{{item.label}}</view>
      </view>
    </view>

    <view class="qr card">
      <view class="qr-icon">▣</view>
      <view>
        <view>{{poster.qrTitle}}</view>
        <view class="muted">{{poster.qrDesc}}</view>
      </view>
    </view>
  </view>

  <view class="action-row">
    <view class="secondary-btn" bindtap="onSave">保存</view>
    <view class="primary-btn" bindtap="onSend">发送</view>
  </view>
</view>
