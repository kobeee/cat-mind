.title {
  margin-top: 16rpx;
  font-size: 52rpx;
  font-weight: 700;
}

.sub {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.sound-grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.sound {
  position: relative;
  min-height: 170rpx;
}

.icon {
  font-size: 40rpx;
}

.name {
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.play {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #ff7a50;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
}

.build {
  margin-top: 22rpx;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 20, 30, 0.42);
  display: flex;
  align-items: flex-end;
  padding: 20rpx;
}

.modal {
  width: 100%;
}

.modal-title {
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.modal-option {
  height: 76rpx;
  border-radius: 16rpx;
  background: #232836;
  color: #e5e7eb;
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
