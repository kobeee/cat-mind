<view class="screen">
  <view class="nav">
    <view class="icon-btn" bindtap="onBack">←</view>
    <view class="nav-title">CBTI性格测试</view>
    <view class="progress-text">{{current + 1}}/{{questions.length}}</view>
  </view>

  <view class="top-bar">
    <view class="top-fill" style="width: {{((current + 1) / questions.length) * 100}}%;"></view>
  </view>

  <view class="card question-card">
    <view class="q-no">QUESTION {{(current + 1) < 10 ? '0' + (current + 1) : (current + 1)}}</view>
    <view class="q-title">{{questions[current].title}}</view>
  </view>

  <view class="option-wrap">
    <view
      class="option {{answers[current] === index ? 'active' : ''}}"
      wx:for="{{questions[current].options}}"
      wx:key="*this"
      data-idx="{{index}}"
      bindtap="onPick"
    >
      <view class="mark">{{index === 0 ? 'A' : index === 1 ? 'B' : 'C'}}</view>
      <view>{{item}}</view>
    </view>
  </view>

  <view class="tip muted">💡 根据真实行为选择，结果更准确</view>

  <view class="actions">
    <view class="prev" bindtap="onPrev">← 上题</view>
    <view class="primary-btn next" bindtap="onNext">{{current + 1 === questions.length ? '提交答案' : '下一题 →'}}</view>
  </view>
</view>
