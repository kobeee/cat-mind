.top-line {
  height: 6rpx;
  margin: -20rpx -20rpx 16rpx;
  background: linear-gradient(90deg, #ff7a50, #ff6b6b);
}

.model-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #ff7a50;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.model-name {
  font-size: 44rpx;
  font-weight: 700;
}

.model-code {
  font-size: 20rpx;
  color: #7a8194;
}

.score-wrap {
  margin-left: auto;
  text-align: right;
}

.score {
  color: #ffd166;
  font-size: 32rpx;
  font-weight: 700;
}

.small {
  font-size: 20rpx;
}

.quote-card,
.spec-card,
.guide-card {
  margin-top: 14rpx;
}

.quote-title,
.spec-title {
  color: #ff7a50;
  font-size: 24rpx;
}

.quote {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #eceef3;
  font-style: italic;
}

.spec-row {
  margin-top: 14rpx;
  display: flex;
  justify-content: space-between;
}

.guide-box {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 12rpx;
}

.good,
.bad {
  border-radius: 16rpx;
  padding: 14rpx;
  font-size: 22rpx;
}

.good {
  color: #b8ffda;
  background: #144523;
}

.bad {
  color: #ffd0d0;
  background: #4b1d1d;
}

.btn-wrap {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
