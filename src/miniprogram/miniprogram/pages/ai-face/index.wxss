.title-wrap {
  margin: 18rpx 0;
}

.main {
  font-size: 52rpx;
  font-weight: 700;
}

.sub {
  margin-top: 10rpx;
  font-size: 24rpx;
}

.upload {
  min-height: 350rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.ring {
  width: 120rpx;
  height: 120rpx;
  border: 6rpx solid #ff7a50;
  border-radius: 50%;
}

.photo {
  width: 100%;
  height: 320rpx;
  border-radius: 20rpx;
}

.upload-text {
  font-size: 32rpx;
  font-weight: 600;
}

.scan {
  margin-top: 18rpx;
}

.scan-head {
  display: flex;
  justify-content: space-between;
  color: #fff;
  font-size: 24rpx;
}

.progress {
  margin-top: 12rpx;
  height: 6rpx;
  background: #4b5566;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ff7a50, #ff6b6b);
}

.tag-row {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
}

.tag {
  padding: 8rpx 16rpx;
  border-radius: 14rpx;
  font-size: 20rpx;
  color: #111;
  background: #ffd166;
}

.btn-wrap {
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
