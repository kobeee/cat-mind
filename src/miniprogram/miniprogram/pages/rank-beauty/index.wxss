.center-nav {
  justify-content: center;
}

.beauty-active {
  color: #fff;
  background: linear-gradient(90deg, #b66cff, #ff6ba6);
}

.podium {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.podium-item {
  text-align: center;
}

.ball {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  margin: 0 auto 8rpx;
}

.ball.sm {
  width: 44rpx;
  height: 44rpx;
  margin: 0;
}

.name {
  font-size: 26rpx;
  font-weight: 600;
}

.score {
  color: #ff5fa8;
  font-weight: 600;
}

.rank-card {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rank {
  width: 30rpx;
  color: #6b7280;
}

.meta {
  flex: 1;
}

.footer {
  margin-top: 16rpx;
  text-align: center;
  font-size: 20rpx;
}
