page {
  --bg-page: #f5f5f7;
  --bg-card: #ffffff;
  --bg-dark: #05070d;
  --bg-dark-card: #151821;
  --text-main: #111827;
  --text-sub: #6b7280;
  --coral: #ff7a50;
  --coral-end: #ff6b6b;
  --gold: #ffd166;
  --line: #e5e7eb;
  background: var(--bg-page);
  color: var(--text-main);
  min-height: 100%;
  font-family: 'PingFang SC', 'Helvetica Neue', sans-serif;
  box-sizing: border-box;
}

.screen {
  min-height: 100vh;
  padding: calc(env(safe-area-inset-top) + 20rpx) 20rpx 180rpx;
}

.screen.dark {
  background: var(--bg-dark);
  color: #f5f7fa;
}

.nav {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-title {
  font-size: 32rpx;
  font-weight: 600;
}

.icon-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6b7280;
  background: #f0f2f6;
}

.dark .icon-btn {
  background: #202332;
  color: #c6cad3;
}

.card {
  background: var(--bg-card);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(19, 20, 29, 0.08);
  padding: 24rpx;
}

.dark-card {
  background: linear-gradient(135deg, #151821, #232835);
  border-radius: 24rpx;
  padding: 24rpx;
}

.primary-btn,
.secondary-btn {
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.primary-btn {
  color: #fff;
  background: linear-gradient(90deg, var(--coral), var(--coral-end));
  box-shadow: 0 12rpx 24rpx rgba(255, 122, 80, 0.35);
}

.secondary-btn {
  color: #4b5563;
  background: #fff;
  border: 1rpx solid #d6d8df;
}

.dark .secondary-btn {
  color: #d5d8de;
  background: #202331;
  border-color: #2e3244;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  margin: 26rpx 0 18rpx;
}

.muted {
  color: var(--text-sub);
}

.segment {
  height: 72rpx;
  border-radius: 18rpx;
  background: #f0f1f5;
  display: flex;
  padding: 6rpx;
}

.segment-item {
  flex: 1;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #6b7280;
}

.segment-item.active {
  color: #fff;
  background: linear-gradient(90deg, #ffb800, #ff7a50);
}

.dark .segment {
  background: #1d2030;
}

.dark .segment-item.active {
  background: linear-gradient(90deg, #cb6ce6, #ff6ba6);
}
